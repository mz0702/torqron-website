---
// Section with heading, intro and a horizontally scrolling rail of cards (slot).
interface Props {
  title: string;
  id?: string;
  /** heading level of the section title */
  level?: 'h2' | 'h3';
  class?: string;
}
const { title, id, level: H = 'h2', class: cls = '' } = Astro.props;
---

<section class:list={['limiter', cls]} id={id} data-rail>
  <div>
    <div class="teasers__head" data-reveal>
      <div class="teasers__intro">
        <H class={H === 'h3' ? 'h3' : undefined}>{title}</H>
        <slot name="intro" />
      </div>
      <div class="teasers__controls">
        <button class="round-btn" type="button" aria-label="Previous" data-prev>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 5.5-5.5M5 12l5.5 5.5" /></svg>
        </button>
        <button class="round-btn" type="button" aria-label="Next" data-next>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m0 0-5.5-5.5M19 12l-5.5 5.5" /></svg>
        </button>
      </div>
    </div>
    <div class="teasers__rail" data-reveal>
      <slot />
    </div>
  </div>
</section>
