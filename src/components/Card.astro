---
// Teaser card: photo with overlay, title on top, pill button (or a round arrow on compact cards).
// The whole card is one link (the title's link is stretched over it).
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { img } from '../data/images';
interface Props {
  href: string;
  title: string;
  /** file name in src/assets/img */
  image?: string;
  alt?: string;
  cta?: string;
  /** one line shown on hover */
  teaser?: string;
  /** smaller title and a round arrow instead of the pill, for dense grids */
  compact?: boolean;
  /** heading level of the title */
  level?: 'h2' | 'h3' | 'h4';
}
const { href, title, image, alt = '', cta = 'Learn more', teaser, compact = false, level: H = 'h3' } = Astro.props;
---

<article class:list={['card card--photo', compact && 'card--compact']}>
  {image && <Image class="card__media" src={img(image)} alt={alt} widths={[400, 640, 960]} sizes={compact ? '(max-width: 640px) 46vw, (max-width: 1100px) 31vw, 23vw' : '(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 31vw'} quality={72} loading="eager" draggable="false" />}
  <div class="card__overlay">
    <H class="card__title"><a href={href} draggable="false">{title}</a></H>
    {teaser && <p class="card__teaser">{teaser}</p>}
    {
      compact ? (
        <span class="round-btn card__go" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8.5 7H17v8.5" /></svg>
        </span>
      ) : (
        <Button as="span" tone="white" aria-hidden="true">{cta}</Button>
      )
    }
  </div>
</article>
