---
import Button from './Button.astro';
import { nav, legalNav, site } from '../data/site';
interface Props {
  /** true on pages without a dark hero: blue logo and text from the start */
  solid?: boolean;
}
const { solid = false } = Astro.props;
const path = Astro.url.pathname;
// open the menu on the section the visitor is in, otherwise on the first one
const current = Math.max(0, nav.findIndex((item) => path.startsWith(item.href) || item.children.some((c) => c.href === path)));
---

<a class="skip" href="#main">Skip to content</a>

<header class:list={['header limiter', solid && 'is-solid']} data-header>
  <div class="header__inner">
    <a class="logo" href="/" aria-label="TORQRON – home">
      <img class="logo__white" src="/brand/torqron-logo-white.png" alt="" width="1110" height="112" />
      <img class="logo__colour" src="/brand/torqron-logo.png" alt="" width="1110" height="112" />
    </a>
    <div class="header__tools">
      <Button class="header__cta" href="/contact/">Request a quote</Button>
      <button class="burger" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
        <span class="burger__label">Menu</span>
        <svg viewBox="0 0 30 22" aria-hidden="true"><rect x="0" y="6" width="30" height="2"></rect><rect x="0" y="14" width="30" height="2"></rect></svg>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu on-dark" id="menu" aria-label="Site navigation" data-menu>
  <div class="limiter">
    <div class="menu__bar">
      <a class="logo" href="/" aria-label="TORQRON – home">
        <img src="/brand/torqron-logo-white.png" alt="" width="1110" height="112" />
      </a>
      <button class="menu__close" type="button" data-menu-close>
        <span>Close</span>
        <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 3l16 16M19 3 3 19"></path></svg>
      </button>
    </div>
  </div>

  <nav class="menu__body limiter" aria-label="Main">
    <div>
      <!-- Each main item carries its subpages; hovering or focusing an item shows them on the right. -->
      <ul class="menu__main">
        {
          nav.map((item, i) => (
            <li class:list={['menu__item', i === current && 'is-active']} data-menu-item>
              <a class="menu__link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
              <div class="menu__panel">
                <ul class:list={[item.children.length > 7 && 'cols-2']}>
                  {item.children[0].href !== item.href && (
                    <li style="--i:0">
                      <a href={item.href}>All {item.label.toLowerCase()}</a>
                    </li>
                  )}
                  {item.children.map((c, k) => (
                    <li style={`--i:${k + 1}`}>
                      <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="menu__service">
        <ul>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/capabilities/">Capabilities</a></li>
          {legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <Button tone="white" icon="mail" href={`mailto:${site.email}`}>{site.email}</Button>
      </div>
    </div>
  </nav>
</dialog>
