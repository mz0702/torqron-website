---
// Article-style tile: image above, dot label, title and a line of text below.
import { Image } from 'astro:assets';
import { img } from '../data/images';
interface Props {
  href: string;
  title: string;
  label: string;
  text?: string;
  image: string;
  alt?: string;
  level?: 'h2' | 'h3' | 'h4';
}
const { href, title, label, text, image, alt = '', level: H = 'h3' } = Astro.props;
---

<article class="tile">
  <Image class="tile__media" src={img(image)} alt={alt} widths={[480, 720, 960]} sizes="(max-width: 840px) 92vw, (max-width: 1200px) 46vw, 31vw" quality={72} loading="eager" />
  <p class="tile__label">{label}</p>
  <H class="tile__title"><a href={href}>{title}</a></H>
  {text && <p>{text}</p>}
</article>
