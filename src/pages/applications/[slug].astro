---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import TeaserRail from '../../components/TeaserRail.astro';
import CtaBar from '../../components/CtaBar.astro';
import { applications, products, services } from '../../data/site';
import { applicationContent, bySlug, faqSchema } from '../../data/applications';

export function getStaticPaths() {
  return applications.map((a) => {
    const content = applicationContent[a.slug];
    if (!content) throw new Error(`No content in src/data/applications.ts for application "${a.slug}"`);
    return { params: { slug: a.slug }, props: { a, content } };
  });
}

const { a, content: c } = Astro.props;

const crumbs = [
  { name: 'Applications', href: '/applications/' },
  { name: a.name, href: `/applications/${a.slug}/` },
];
const quote = `/contact/?topic=${encodeURIComponent(c.topic)}`;
const linked = new Set(c.offerings.map((o) => o.href));
const rows = [
  ...c.offerings,
  ...bySlug(services, c.services)
    .filter((s) => !linked.has(`/services/${s.slug}/`))
    .map((s) => ({ name: s.name, text: s.teaser, href: `/services/${s.slug}/` })),
];
const related = bySlug(products, c.products);
const others = applications.filter((x) => x.slug !== a.slug);
---

<Base title={c.title} description={c.description} crumbs={crumbs} schema={[faqSchema(c.faq)]} solidHeader footerGap>
  <PageHero title={c.h1} lede={c.lede} crumbs={crumbs} image={a.image} alt={a.imageAlt} focus={c.focus} />

  <section class="limiter block--top block--bottom">
    <div class="grid12 content">
      <div class="content__main prose" data-reveal>
        <h2>{c.heading}</h2>
        {c.intro.map((p, i) => <p class={i === 0 ? 'lede' : undefined} set:html={p} />)}
        <p class="action"><Button variant="solid" href={quote}>Request a quote</Button></p>
      </div>
      <aside class="content__aside">
        <div class="facts">
          <h2>Typical applications</h2>
          <ul class="dash">{c.uses.map((u) => <li>{u}</li>)}</ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="panel panel--tint limiter">
    <div class="block--top block--bottom">
      <h2 data-reveal>What TORQRON supplies for {c.audience}</h2>
      <ul class="rows" data-reveal>
        {
          rows.map((r) => (
            <li class="row">
              <h3 class="row__title">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</h3>
              <p>{r.text}</p>
              {r.href && (
                <span class="round-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8.5 7H17v8.5" /></svg>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="limiter block--top">
    <div>
      <h2 data-reveal>Products for {c.audience}</h2>
      <div class="cards">
        {
          related.map((p, i) => (
            <div data-reveal style={`--i:${i % 3}`}>
              <Card href={`/products/${p.slug}/`} title={p.name} image={p.image} alt={p.imageAlt} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="limiter block--top block--bottom">
    <div class="grid12 content">
      <div class="content__main" data-reveal>
        <h2>Frequently asked questions</h2>
        <div class="accordion">
          {
            c.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="accordion__body">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBar
    title="Send us your requirements."
    text={`Part number, OEM reference, drawing or photo: our team identifies and sources components for ${c.audience}.`}
    href={quote}
  />

  <TeaserRail title="Other industries" level="h2" class="block--top">
    <p slot="intro">Parts and services across the petrochemical value chain, or back to the <a href="/applications/">applications overview</a>.</p>
    {others.map((o) => <Card href={`/applications/${o.slug}/`} title={o.name} image={o.image} alt={o.imageAlt} teaser={o.teaser} />)}
  </TeaserRail>
</Base>

<style>
  .action {
    margin-top: 2.4rem;
  }
</style>
